{
  "issuer": "https://yarnhen.com",
  "authorization_endpoint": "https://yarnhen.com/v1/oauth/authorize",
  "token_endpoint": "https://yarnhen.com/v1/oauth/token",
  "registration_endpoint": "https://yarnhen.com/v1/oauth/register",
  "revocation_endpoint": "https://yarnhen.com/v1/oauth/revoke",
